{
  "name": "ai-hub",
  "version": "1.5.0",
  "description": "Desktop AI Hub — all your AI services in one place",
  "main": "out/main/main.js",
  "homepage": "https://github.com/axiscoretech/ai-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiscoretech/ai-hub"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test",
    "open-app": "node scripts/open-local-app.js",
    "verify:extensions": "electron scripts/verify-extensions.js",
    "dist": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:arm": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "release": "npm run build && electron-builder --mac --x64 --publish always && electron-builder --mac --arm64 --publish always",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.aihub.desktop",
    "productName": "AI Hub",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/icon.png",
      "package.json",
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "afterSign": "scripts/notarize.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.3.0"
  }
}
